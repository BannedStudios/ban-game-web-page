---
// Encabezado de sección: antetítulo opcional + titular en Anton dorado
const { title, kicker, align = 'center', as: Tag = 'h2', size = 'md' } = Astro.props as {
    title: string; kicker?: string; align?: 'center' | 'left'; as?: any; size?: 'md' | 'lg';
};
const sizeClass = size === 'lg' ? 'text-[clamp(2.6rem,6vw,4.4rem)]' : 'text-[clamp(2rem,4vw,2.8rem)]';
---

<div class={`flex flex-col ${align === 'center' ? 'items-center text-center' : 'items-start text-left'} ${Astro.props.class ?? ''}`}>
    {kicker && <div class="kicker">{kicker}</div>}
    <Tag class={`word ${sizeClass} ${kicker ? 'mt-3' : ''}`}>{title}</Tag>
    <slot />
</div>
