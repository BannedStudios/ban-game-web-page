---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { getCollection } from "astro:content";
import { getLang } from "../i18n/utils";

const lang = getLang(Astro.cookies, Astro.request);

// Más recientes primero; el número es el "order" del proyecto, como en el índice de la portada
const allProjects = await getCollection('proyectos');
const rawProjects = allProjects
  .filter((item) => item.slug.startsWith(`${lang}/`))
  .map((item) => ({
    ...item.data,
    slug: item.slug.replace(`${lang}/`, "")
  }))
  .sort((a, b) => (b.order ?? 0) - (a.order ?? 0));

const projectImages = import.meta.glob<{ default: ImageMetadata }>('../assets/projects/*.{png,jpg,jpeg,webp,avif,svg}', { eager: true });

const projectPictures = rawProjects.map((project) => {
    const avatar = Object.entries(projectImages).find(([path]) => {
        const filename = path.split('/').pop()?.replace(/\.[^.]+$/, '');
        return filename === project.slug;
    })?.[1]?.default;
    return { ...project, avatar };
});
---

<!-- Tarjeta de proyecto (manual de marca · componentes web): imagen, número, título, tipo y fecha; marco al pasar el cursor -->
<div class="grid grid-cols-[repeat(auto-fill,minmax(260px,1fr))] gap-6 w-full max-w-[1200px] px-5">
  {
    projectPictures.map((project) => {
      const isSerie = project.type?.toLowerCase().startsWith('seri');
      return (
        <a href={`/projects/${project.slug}/`} class="frame frame-sm frame-hover group block">
          <article class="card p-2.5 h-full flex flex-col">
            <div class="overflow-hidden chamfer">
              <Image src={project.avatar!} alt={project.title} format="webp" quality="high" width={520} height={520}
                     class="w-full aspect-square object-cover transition-transform duration-500 group-hover:scale-[1.04]" transition:name={project.slug} />
            </div>
            <div class="px-2 pt-4 pb-2 flex flex-col gap-3 flex-1">
              <span class="num text-[0.8rem]">{String(project.order).padStart(2, '0')}</span>
              <h3 class="display text-[1.35rem] leading-[1.05] text-white group-hover:text-oro transition-colors duration-300">{project.title}</h3>
              <div class="flex items-center justify-between gap-3 mt-auto">
                <span class={`tag ${isSerie ? 'tag-serie' : ''}`}>{project.type}</span>
                <span class="mono text-[0.78rem] text-texto-3">{project.date}</span>
              </div>
            </div>
          </article>
        </a>
      )
    })
  }
</div>
