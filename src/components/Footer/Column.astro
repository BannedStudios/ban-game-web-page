---
import Title from "./Title.astro"

const title = Astro.props.title
const COL = Astro.props.col
---

<div>
    <Title>{title}</Title>
    <ul class="flex flex-col gap-2.5 text-[0.92rem]">
        {
            COL.map((col: any) => (
                <li>
                    <a href={col.url} target={`${col.blank === true ? "_blank" : ""}`} class="text-texto-2 hover:text-texto transition-colors duration-300">{col.name}</a>
                </li>
            ))
        }
    </ul>
</div>
