---
// Tweets con el estilo de la marca (sin el widget de X): tarjeta oscura con corte, autor, texto, imagen o vídeo,
// fecha, me gusta y respuestas. Los datos se leen en el servidor (libs/tweets.ts).
import { getTweet } from "../libs/tweets";
import { getLang } from "../i18n/utils";

const { profiles = [] } = Astro.props as { profiles: { src: string }[] };
const lang = getLang(Astro.cookies, Astro.request);
// Los tweets borrados o que X no devuelve se omiten para no dejar tarjetas vacías
const tweets = (await Promise.all(profiles.map(async (p) => ({ src: p.src, data: await getTweet(p.src) })))).filter((t) => t.data);

const fmtDate = (iso: string) => new Date(iso).toLocaleString(lang === "es" ? "es" : "en", { day: "numeric", month: "short", year: "numeric", hour: "2-digit", minute: "2-digit" });
const fmtNum = (n: number) => new Intl.NumberFormat(lang === "es" ? "es" : "en", { notation: "compact" }).format(n);
const L = lang === "es" ? { open: "Ver en X", fallback: "Ver este tweet en X", likes: "me gusta", replies: "respuestas" } : { open: "View on X", fallback: "View this tweet on X", likes: "likes", replies: "replies" };
---

<!-- Filas centradas: con menos tweets que columnas quedan en el centro (3 por fila en PC, 2 en tablet, 1 en móvil) -->
<div class="flex flex-wrap justify-center gap-[22px] w-full max-w-[1240px] px-5 mt-6">
    {tweets.map(({ src, data: tw }) => tw ? (
        <div class="tweet-edge w-[calc((100%-44px)/3)] max-[1000px]:w-[calc((100%-22px)/2)] max-[680px]:w-full"><article class="tweet card p-5 flex flex-col h-full">
            <!-- Autor -->
            <header class="flex items-center gap-3">
                <a href={`https://x.com/${tw.handle}`} target="_blank" rel="noopener noreferrer" class="shrink-0">
                    <img src={tw.avatar} alt="" width="42" height="42" loading="lazy" class="w-[42px] h-[42px] object-cover chamfer-sm bg-superficie" />
                </a>
                <div class="min-w-0 flex-1">
                    <a href={`https://x.com/${tw.handle}`} target="_blank" rel="noopener noreferrer" class="display block text-[18px] leading-none text-texto truncate hover:text-oro transition-colors duration-300">{tw.name}</a>
                    <div class="mono text-[12.2px] text-texto-3 mt-[5px] truncate">@{tw.handle}</div>
                </div>
                <a href={tw.url} target="_blank" rel="noopener noreferrer" aria-label={L.open} class="shrink-0 text-texto-3 hover:text-oro transition-colors duration-300">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18.9 2H22l-6.8 7.8L23.2 22h-6.3l-4.9-6.4L6.4 22H3.3l7.3-8.3L2.9 2h6.4l4.4 5.8L18.9 2Zm-1.1 18.1h1.7L8.3 3.8H6.5l11.3 16.3Z"/></svg>
                </a>
            </header>

            <!-- Texto (máx. 6 líneas; el resto en X) -->
            {tw.html && <p class="tweet-text text-[15px] leading-[1.55] text-texto-2 mt-4 break-words line-clamp-6" set:html={tw.html}></p>}

            <!-- Imagen o vídeo en su proporción real (sin recortar), hasta 340 px de alto; varias en cuadrícula de 170 px -->
            {tw.media.length > 0 && (
                <a href={tw.url} target="_blank" rel="noopener noreferrer" class={`grid gap-[6px] mt-4 ${tw.media.length > 1 ? 'grid-cols-2' : ''}`}>
                    {tw.media.map((m) => (
                        <span class="relative block overflow-hidden chamfer-sm bg-superficie">
                            <img src={m.src} alt="" loading="lazy" width={m.w} height={m.h}
                                 class={`block w-full ${tw.media.length > 1 ? 'object-cover aspect-square max-h-[170px]' : 'object-contain max-h-[340px]'}`}
                                 style={tw.media.length === 1 && m.w && m.h ? `aspect-ratio:${m.w}/${m.h}` : undefined} />
                            {m.type === 'video' && (
                                <span class="absolute inset-0 grid place-items-center bg-black/25">
                                    <span class="grid place-items-center w-[52px] h-[52px] chamfer-sm bg-oro text-fondo">
                                        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M7 4.5v15l13-7.5z"/></svg>
                                    </span>
                                </span>
                            )}
                        </span>
                    ))}
                </a>
            )}

            <!-- Pie: fecha, me gusta, respuestas y enlace -->
            <footer class="mt-auto pt-4">
                <div class="mono text-[12.2px] text-texto-3 mt-4">{fmtDate(tw.date)}</div>
                <div class="flex items-center justify-between gap-3 mt-3 pt-3 border-t border-linea">
                    <div class="flex items-center gap-4 mono text-[12.2px] text-texto-2">
                        <span class="flex items-center gap-[6px]" title={L.likes}>
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" class="text-oro" aria-hidden="true"><path d="M12 21s-7.5-4.6-10-9.3C.4 8.4 2.3 4.5 6 4.5c2.1 0 3.4 1.1 4 2.2.6-1.1 1.9-2.2 4-2.2 3.7 0 5.6 3.9 4 7.2C19.5 16.4 12 21 12 21Z"/></svg>
                            {fmtNum(tw.likes)}
                        </span>
                        <span class="flex items-center gap-[6px]" title={L.replies}>
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" class="text-oro" aria-hidden="true"><path d="M4 5h16v11H9l-5 4V5Z"/></svg>
                            {fmtNum(tw.replies)}
                        </span>
                    </div>
                    <a href={tw.url} target="_blank" rel="noopener noreferrer" class="link-arrow !text-[11.6px]">{L.open}</a>
                </div>
            </footer>
        </article></div>
    ) : (
        <a href={src} target="_blank" rel="noopener noreferrer" class="card p-5 flex items-center justify-between gap-3 group w-[calc((100%-44px)/3)] max-[1000px]:w-[calc((100%-22px)/2)] max-[680px]:w-full">
            <span class="text-texto-2 group-hover:text-oro transition-colors duration-300">{L.fallback}</span>
            <span class="text-oro">→</span>
        </a>
    ))}
</div>

<style>
    /* Borde fino con el corte en diagonal (mismo método que el botón con contorno): el contenedor hace de línea
       y la tarjeta va 1 px hacia dentro con el mismo corte; dorado al pasar el cursor */
    .tweet-edge {
        padding: 1px; background: var(--color-linea-2); transition: background-color .25s ease;
        clip-path: polygon(15px 0, 100% 0, 100% calc(100% - 15px), calc(100% - 15px) 100%, 0 100%, 0 15px);
    }
    .tweet-edge:hover { background: rgba(240, 184, 58, .55); }
    .tweet-edge > .tweet {
        clip-path: polygon(14.6px 0, 100% 0, 100% calc(100% - 14.6px), calc(100% - 14.6px) 100%, 0 100%, 0 14.6px);
    }
    .tweet-text :global(a) { color: var(--color-oro); }
    .tweet-text :global(a:hover) { text-decoration: underline; text-underline-offset: 3px; }
</style>
