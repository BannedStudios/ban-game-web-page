---
import Layout from '../layouts/Layout.astro';
import Next from '../components/Icons/Next.astro';
import Prev from '../components/Icons/Prev.astro';
import YTVideo from '../components/YTVideo.astro';
import Hero from '../components/Hero.astro';
import BriefCase from '../components/Icons/BriefCase.astro';
import Mail from '../components/Icons/Mail.astro';
import PhotoStack from '../components/PhotoStack.astro';
import { getAllStaff } from '../libs/firestore/staff';
import SectionHead from '../components/SectionHead.astro';
import Cat from '../components/Icons/Cat.astro';
import { getCollection } from 'astro:content';
import { getLang, useTranslations } from '../i18n/utils';

const lang = getLang(Astro.cookies, Astro.request);
const t = useTranslations(lang);

const { videos } = await import(`../data/${lang}/index.ts`);

// Índice de proyectos: los más recientes primero (mayor "order")
const all = await getCollection('proyectos', ({ data }) => !data.hidden);
const proyectos = all
  .filter((item) => item.slug.startsWith(`${lang}/`))
  .map((item) => ({ ...item.data, slug: item.slug.replace(`${lang}/`, "") }))
  .sort((a, b) => (b.order ?? 0) - (a.order ?? 0));
const recientes = proyectos.slice(0, 6);
const years = proyectos.map((p) => (p.date.match(/\d{4}/) || [])[0]).filter(Boolean).map(Number);
const range = years.length ? `${Math.min(...years)}–${Math.max(...years)}` : '';

// Equipo: avatares del staff (Firebase) para la sección «Nuestro equipo»
const team = await getAllStaff().catch(() => []);
const teamItems = team.map((m: { avatar: string; name: string }) => ({ src: m.avatar, alt: m.name }));

const services = [
  { title: t('index.services.mods.title'), desc: t('index.services.mods.desc') },
  { title: t('index.services.builds.title'), desc: t('index.services.builds.desc') },
  { title: t('index.services.events.title'), desc: t('index.services.events.desc') },
];
---

<Layout title="Banned Studios" desc={`${t('index.desc')}`}>
    <Hero/>

    <main class="w-full max-w-[1240px] mx-auto px-5 mb-20 flex flex-col gap-20 max-[760px]:gap-14">
        <!-- Índice de proyectos (manual · página web): columnas 180 px + resto, filas 40 · 1fr · 110 · 100 · 20 (×1,22) -->
        <section id="proyectos" class="rule mt-[20px] pt-[10px] grid grid-cols-[220px_1fr] gap-[29px] max-[1024px]:grid-cols-1 max-[1024px]:gap-3 scroll-mt-24">
            <div>
                <div class="kicker">{t('nav.projects')}</div>
                <div class="mono text-[13.4px] text-texto-3 mt-[7px]">{t('index.projectsIndex')} · {range}</div>
            </div>
            <ol>
                {recientes.map((p) => (
                    <li>
                        <a href={`/projects/${p.slug}/`} class="group grid grid-cols-[49px_1fr_134px_122px_24px] max-[640px]:grid-cols-[34px_1fr_20px] items-center py-[6px] max-[640px]:py-[9px] border-b border-linea">
                            <span class="num text-[13.4px]">{String(p.order).padStart(2, '0')}</span>
                            <span class="text-[15.9px] font-semibold text-texto truncate pr-4 group-hover:text-oro transition-colors duration-300">{p.title}</span>
                            <span class="text-[13.4px] text-texto-2 max-[640px]:hidden">{p.type}</span>
                            <span class="mono text-[13.4px] text-texto-3 max-[640px]:hidden">{p.date}</span>
                            <span class="text-oro text-[14.7px] transition-transform duration-300 group-hover:translate-x-1">→</span>
                        </a>
                    </li>
                ))}
            </ol>
        </section>

        <!-- Videos destacados -->
        <section data-carousel-root class="flex flex-col items-center">
            <SectionHead title={t('index.videosTitle')} />
            <div class="w-full max-w-[1240px] mt-8 overflow-hidden">
                <div data-carousel data-gap="20" class="flex items-center gap-5 overflow-x-auto scroll-smooth snap-x snap-mandatory">
                    {
                        videos.map((video: { src: any; title: any; }) => (
                            <div class="w-[calc((100%-40px)/3)] max-[900px]:w-[calc((100%-20px)/2)] max-[560px]:w-full snap-start shrink-0 media">
                                <YTVideo url={video.src} title={video.title}/>
                            </div>
                        ))
                    }
                </div>
            </div>

            <div class="flex flex-row gap-2 mt-6">
                <button data-carousel-prev class="btn btn-ghost btn-icon" aria-label="Anterior"><Prev class="w-5 h-5"/></button>
                <button data-carousel-next class="btn btn-ghost btn-icon" aria-label="Siguiente"><Next class="w-5 h-5"/></button>
            </div>
        </section>

        <!-- Qué ofrecemos: misma composición que el índice de proyectos (columna de título + lista numerada con líneas) -->
        <section class="rule pt-[10px] grid grid-cols-[minmax(0,400px)_1fr] gap-[48px] max-[1024px]:grid-cols-1 max-[1024px]:gap-6">
            <div class="self-start pt-[16px]">
                <div class="kicker">{t('index.servicesKicker')}</div>
                <h2 class="word text-[clamp(2.4rem,4.6vw,3.9rem)] !leading-[1.05] mt-3">{t('index.servicesTitle')}</h2>
                <div class="mono text-[13.4px] text-texto-3 mt-3">{t('index.servicesCount')}</div>
            </div>
            <ol>
                {services.map((s, i) => (
                    <li class="group grid grid-cols-[72px_1fr] max-[560px]:grid-cols-[48px_1fr] gap-x-[20px] items-start pt-[26px] pb-[21px] first:pt-[15px] border-b border-linea">
                        <span class="word text-[46px] max-[560px]:text-[34px] leading-none">0{i + 1}</span>
                        <div class="min-w-0">
                            <h3 class="display text-[27px] max-[560px]:text-[23px] leading-[1.05] text-texto group-hover:text-oro transition-colors duration-300">{s.title}</h3>
                            <p class="text-[15.9px] leading-[1.6] mt-[8px] max-w-[560px]">{s.desc}</p>
                        </div>
                    </li>
                ))}
            </ol>
        </section>

        <!-- Nuestro equipo: misma composición que «Qué ofrecemos»; avatares superpuestos en el marco y enlaces a Staff y Postúlate -->
        {teamItems.length > 0 && (
        <section class="rule pt-[25px] grid grid-cols-[minmax(0,400px)_1fr] gap-[48px] items-center max-[1024px]:grid-cols-1 max-[1024px]:gap-6">
            <div>
                <div class="kicker">{t('index.teamKicker')}</div>
                <h2 class="word text-[clamp(2.4rem,4.6vw,3.9rem)] !leading-[1.05] mt-3">{t('index.teamTitle')}</h2>
                <div class="mono text-[13.4px] text-texto-3 mt-3">{teamItems.length} {t('index.teamCount')}</div>
            </div>
            <div class="flex items-center justify-between gap-8 flex-wrap max-[1024px]:justify-start">
                <PhotoStack items={teamItems.slice(0, 8)} more={Math.max(0, teamItems.length - 8)} size={72} class="max-[700px]:hidden" />
                <PhotoStack items={teamItems.slice(0, 5)} more={Math.max(0, teamItems.length - 5)} size={56} class="hidden max-[700px]:block" />
                <div class="flex flex-col gap-4 items-start">
                    <p class="text-[15.9px] leading-[1.6] max-w-[300px]">{t('index.teamDesc')}</p>
                    <div class="flex flex-wrap items-center gap-[22px]">
                        <a class="link-arrow" href="/staff/">{t('index.teamLink')}</a>
                        <a class="btn btn-secondary btn-sm" href="/apply/">{t('nav.apply')}</a>
                    </div>
                </div>
            </div>
        </section>
        )}

        <!-- Llamada final -->
        <section class="frame frame-lg">
            <div class="card px-10 py-12 text-center flex flex-col items-center max-[560px]:px-6">
                <div class="tagline">Minecraft <Cat size={15} /> Studio</div>
                <h2 class="word text-[clamp(2rem,4.4vw,3.2rem)] mt-4">{t('index.cta.title')}</h2>
                <p class="mt-4 max-w-[620px] text-[1.1rem] leading-[1.6]">{t('index.cta.desc')}</p>
                <div class="flex flex-wrap gap-4 mt-8 justify-center items-center">
                    <a class="btn btn-primary" href="/contact/">
                        <Mail />
                        <span>{t('index.cta.contact')}</span>
                    </a>
                    <a class="btn btn-secondary" href="/apply/">
                        <BriefCase />
                        <span>{t('index.cta.apply')}</span>
                    </a>
                </div>
            </div>
        </section>
    </main>
</Layout>

<style>
    #carousel::-webkit-scrollbar {
        display: none;
    }
    #carousel {
        -ms-overflow-style: none;
        scrollbar-width: none;
    }
</style>

<script>
    // Carrusel común (portada y galería de proyectos): ver src/scripts/carousel.ts
    import '../scripts/carousel';
</script>
