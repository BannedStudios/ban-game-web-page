---
import { Image } from "astro:assets"
import type { ImageMetadata } from "astro"

const { src } = Astro.props

const bannerImages = import.meta.glob<{ default: ImageMetadata }>('../assets/banners/*.{png,jpg,jpeg,webp,avif,svg}', { eager: true });
const image = Object.entries(bannerImages).find(([path]) => {
  const filename = path.split('/').pop()?.replace(/\.[^.]+$/, '');
  return filename === src;
})?.[1]?.default;
---

<div class="opacity-0 transition-opacity duration-1000 ease-in-out overflow-hidden">
    <Image src={image} alt="Banner" format="webp" loading="eager" class="w-full" style="mask-image: linear-gradient(to bottom, black 80%, transparent);" onload="this.parentElement.classList.add('animate-fade-up')"/>
</div>

<style>
    .animate-fade-up {
        opacity: 1;
    }

    @keyframes fadeUp {
        0% {
            opacity: 0;
            transform: translateY(20px);
        }
        100% {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .animate-fade-up {
        animation: fadeUp 1s ease-out forwards;
    }
</style>