---
import Layout from '../layouts/Layout.astro';
import Next from '../components/Icons/Next.astro';
import Prev from '../components/Icons/Prev.astro';
import YTVideo from '../components/YTVideo.astro';
import Hero from '../components/Hero.astro';
import Code from '../components/Icons/Code.astro';
import Cube from '../components/Icons/Cube.astro';
import Gamepad from '../components/Icons/Gamepad.astro';
import BriefCase from '../components/Icons/BriefCase.astro';
import Mail from '../components/Icons/Mail.astro';
import SectionHead from '../components/SectionHead.astro';
import { getCollection } from 'astro:content';
import { getLang, useTranslations } from '../i18n/utils';

const lang = getLang(Astro.cookies, Astro.request);
const t = useTranslations(lang);

const { videos } = await import(`../data/${lang}/index.ts`);

// Índice de proyectos: los más recientes primero (mayor "order")
const all = await getCollection('proyectos');
const proyectos = all
  .filter((item) => item.slug.startsWith(`${lang}/`))
  .map((item) => ({ ...item.data, slug: item.slug.replace(`${lang}/`, "") }))
  .sort((a, b) => (b.order ?? 0) - (a.order ?? 0));
const recientes = proyectos.slice(0, 6);
const years = proyectos.map((p) => (p.date.match(/\d{4}/) || [])[0]).filter(Boolean).map(Number);
const range = years.length ? `${Math.min(...years)}–${Math.max(...years)}` : '';

const services = [
  { icon: Code, title: t('index.services.mods.title'), desc: t('index.services.mods.desc') },
  { icon: Cube, title: t('index.services.builds.title'), desc: t('index.services.builds.desc') },
  { icon: Gamepad, title: t('index.services.events.title'), desc: t('index.services.events.desc') },
];
---

<Layout title="Banned Studios" image="/pages/index.webp" desc={`${t('index.desc')}`}>
    <Hero/>

    <main class="w-full max-w-[1200px] mx-auto px-5 mb-20 flex flex-col gap-20">
        <!-- Índice de proyectos -->
        <section id="proyectos" class="rule pt-6 grid grid-cols-[220px_1fr] gap-8 max-[760px]:grid-cols-1 max-[760px]:gap-4 scroll-mt-24">
            <div>
                <div class="text-[0.75rem] font-semibold tracking-[.32em] uppercase text-oro">{t('nav.projects')}</div>
                <div class="mono text-[0.8rem] text-texto-3 mt-2">{t('index.projectsIndex')} · {range}</div>
                <a href="/projects/" class="link-arrow mt-6 max-[760px]:hidden">{t('index.projectsMore')}</a>
            </div>
            <div>
                <ol>
                    {recientes.map((p) => (
                        <li>
                            <a href={`/projects/${p.slug}/`} class="group grid grid-cols-[48px_1fr_120px_120px_24px] max-[640px]:grid-cols-[40px_1fr_20px] items-center py-3.5 border-b border-linea transition-colors duration-300 hover:bg-[linear-gradient(90deg,rgba(240,184,58,.06),transparent_70%)]">
                                <span class="num text-[0.85rem]">{String(p.order).padStart(2, '0')}</span>
                                <span class="font-semibold text-texto text-[1.02rem] group-hover:text-white truncate pr-4">{p.title}</span>
                                <span class="text-[0.85rem] text-texto-2 max-[640px]:hidden">{p.type}</span>
                                <span class="mono text-[0.8rem] text-texto-3 max-[640px]:hidden">{p.date}</span>
                                <span class="text-oro transition-transform duration-300 group-hover:translate-x-1">→</span>
                            </a>
                        </li>
                    ))}
                </ol>
                <a href="/projects/" class="link-arrow mt-6 hidden max-[760px]:inline-flex">{t('index.projectsMore')}</a>
            </div>
        </section>

        <!-- Videos destacados -->
        <section class="flex flex-col items-center">
            <SectionHead title={t('index.videosTitle')} />
            <div class="w-full max-w-[1200px] mt-8 overflow-hidden">
                <div id="carousel" class="flex items-center gap-5 overflow-x-auto scroll-smooth snap-x snap-mandatory">
                    {
                        videos.map((video: { src: any; title: any; }) => (
                            <div class="w-[370px] max-w-[85vw] snap-start shrink-0 overflow-hidden chamfer-lg">
                                <YTVideo url={video.src} title={video.title}/>
                            </div>
                        ))
                    }
                </div>
            </div>

            <div class="flex flex-row gap-2 mt-6">
                <button id="prev" class="btn btn-ghost btn-icon" aria-label="Anterior"><Prev class="w-5 h-5"/></button>
                <button id="next" class="btn btn-ghost btn-icon" aria-label="Siguiente"><Next class="w-5 h-5"/></button>
            </div>
        </section>

        <!-- Qué ofrecemos -->
        <section class="flex flex-col items-center">
            <SectionHead title={t('index.servicesTitle')} />
            <div class="grid grid-cols-3 gap-5 w-full mt-8 max-[900px]:grid-cols-1">
                {services.map((s, i) => (
                    <article class="card group p-7 text-left relative">
                        <div class="flex items-center justify-between">
                            <div class="w-12 h-12 grid place-items-center chamfer-sm bg-fantasma text-oro transition-transform duration-300 group-hover:scale-110">
                                <s.icon class="w-6 h-6" />
                            </div>
                            <span class="num text-[0.85rem]">0{i + 1}</span>
                        </div>
                        <h3 class="display text-[1.5rem] mt-5 text-texto">{s.title}</h3>
                        <p class="text-[0.92rem] leading-relaxed mt-2">{s.desc}</p>
                    </article>
                ))}
            </div>
        </section>

        <!-- Llamada final -->
        <section class="frame frame-lg">
            <div class="card px-10 py-12 text-center flex flex-col items-center max-[560px]:px-6">
                <div class="kicker">Minecraft <span class="mark w-[14px]"></span> Studio</div>
                <h2 class="word text-[clamp(2rem,4.4vw,3.2rem)] mt-4">{t('index.cta.title')}</h2>
                <p class="mt-3 max-w-[620px] leading-relaxed">{t('index.cta.desc')}</p>
                <div class="flex flex-wrap gap-4 mt-8 justify-center items-center">
                    <a class="btn btn-primary btn-lg" href="/contact/">
                        <Mail />
                        <span>{t('index.cta.contact')}</span>
                    </a>
                    <a class="btn btn-secondary btn-lg" href="/apply/">
                        <BriefCase />
                        <span>{t('index.cta.apply')}</span>
                    </a>
                </div>
            </div>
        </section>
    </main>
</Layout>

<style>
    #carousel::-webkit-scrollbar {
        display: none;
    }
    #carousel {
        -ms-overflow-style: none;
        scrollbar-width: none;
    }
</style>

<script>
    init();

    document.addEventListener('astro:after-swap', init);

    function init () {
        const carousel = document.getElementById('carousel');
        const prev = document.getElementById('prev');
        const next = document.getElementById('next');

        if (next == null || prev == null || carousel == null) return;

        next.addEventListener('click', () => {
            carousel.scrollBy({ left: 390, behavior: 'smooth' });
        });

        prev.addEventListener('click', () => {
            carousel.scrollBy({ left: -390, behavior: 'smooth' });
        });
    }
</script>
