---
import Layout from '../../layouts/Layout.astro';
import Title from '../../components/Title.astro';
import YTVideo from '../../components/YTVideo.astro';
import { Image } from 'astro:assets';
import MiniTitle from '../../components/MiniTitle.astro';
import MainPage from '../../components/MainPage.astro';
import Prev from '../../components/Icons/Prev.astro';
import Next from '../../components/Icons/Next.astro';
import StaffCard from '../../components/StaffCard.astro';
import Desc from '../../components/Desc.astro';
import TweetEmbed from '../../components/TweetEmbed.astro';
import { getLang, useTranslations } from "../../i18n/utils";
import { getCollection, render } from "astro:content";

import type { ImageMetadata } from 'astro';

export const prerender = false;

const { id } = Astro.params;

const lang = getLang(Astro.cookies, Astro.request);
const t = useTranslations(lang);

const allProjects = await getCollection('proyectos', ({ data }) => !data.hidden);
const projectEntry = allProjects.find((item) => item.slug === `${lang}/${id}`);

if (!projectEntry) {
  return new Response(null, { status: 404 });
}

const proyecto = {
  slug: id,
  ...projectEntry.data,
};

const { Content } = await render(projectEntry);

const projectImages = import.meta.glob<{ default: ImageMetadata }>('../../assets/projects/*.{png,jpg,jpeg,webp,avif,svg}', { eager: true });
const image = Object.entries(projectImages).find(([path]) => {
  const filename = path.split('/').pop()?.replace(/\.[^.]+$/, '');
  return filename === proyecto.slug;
})?.[1]?.default;

const gallery = proyecto.gallery || [];
const videos = gallery ? gallery.filter((item: { type: string }) => item.type === "video") : [];
const images = gallery ? gallery.filter((item: { type: string }) => item.type === "image") : [];

const tweets = proyecto.tweets || [];

const credits = proyecto.credits || [];
---

<Layout title={proyecto.title} desc={proyecto.desc}>
    <MainPage class="mt-8">
        <section class="flex flex-col justify-center items-center">
            <div class="frame frame-lg mt-8">
                <Image src={image} alt={proyecto.title} format="webp" quality={92} widths={[240, 320, 480, 640, 800]} sizes="(max-width: 380px) 240px, 320px" loading="eager" class="block w-[320px] h-auto max-h-[420px] object-contain rounded-[4px] max-[380px]:w-[240px]"/>
            </div>
        </section>

        <Title class="mt-8">{proyecto.title}</Title>
        <div class="flex items-center gap-4 mt-4">
            <span class={`tag ${proyecto.type?.toLowerCase().startsWith('seri') ? 'tag-serie' : ''}`}>{proyecto.type}</span>
            <span class="mono text-[0.85rem] text-texto-3">{proyecto.date}</span>
        </div>
        <div class="px-4 mt-6 max-w-[900px] prose prose-invert prose-marca">
            <Content />
        </div>

        {gallery.length > 0 && (
            <div data-carousel-root class="contents">
                <MiniTitle class="mt-12">{t("projects.gallery")}</MiniTitle>
                <div class="w-[calc(100vw-40px)] max-w-[800px] mt-6 mb-5 overflow-hidden">
                    <div data-carousel data-gap="16" class="flex items-center gap-4 overflow-x-auto scroll-smooth snap-x snap-mandatory">
                        {
                            videos.map((video) => (
                                <div class="w-[calc((100%-16px)/2)] max-[560px]:w-full snap-start shrink-0 media">
                                    <YTVideo url={video.src} title={video.title}/>
                                </div>
                            ))
                        }
                        {
                            images.map((image) => (
                                <a href={image.link} title={image.title} target="_blank" class="w-[calc((100%-16px)/2)] max-[560px]:w-full snap-start shrink-0 media">
                                    <span><img src={image.src} class="block object-cover w-full aspect-[16/9]" /></span>
                                </a>
                            ))
                        }
                    </div>
                </div>

                <div class="flex flex-row gap-2">
                    <button data-carousel-prev class="btn btn-ghost btn-icon" aria-label="Anterior"><Prev class="w-5 h-5"/></button>
                    <button data-carousel-next class="btn btn-ghost btn-icon" aria-label="Siguiente"><Next class="w-5 h-5"/></button>
                </div>
            </div>
        )}

        {credits.length > 0 && (
            <>
                <MiniTitle class="mt-14 mb-6">{t("projects.credits")}</MiniTitle>
                <StaffCard profiles={credits}/>
            </>
        )}

        {tweets.length > 0 && (
            <>
                <TweetEmbed profiles={tweets} />
            </>
        )}
    </MainPage>
</Layout>

<style>
    #carousel::-webkit-scrollbar {
        display: none;
    }
    #carousel {
        -ms-overflow-style: none;
        scrollbar-width: none;
    }
</style>

<script>
    // Carrusel común (portada y galería de proyectos): ver src/scripts/carousel.ts
    import '../../scripts/carousel';
</script>
