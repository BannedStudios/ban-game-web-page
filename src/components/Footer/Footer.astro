---
import Networks from "./Networks.astro"
import Column from "./Column.astro"
import { Image } from "astro:assets"
import Title from "./Title.astro"
import { getLang, useTranslations } from "../../i18n/utils";

const lang = getLang(Astro.cookies, Astro.request);
const t = useTranslations(lang);

const COMPANY = [
    {
        name: t('footer.company.about'),
        url: `/about/`
    },
    {
        name: t('footer.company.contact'),
        url: `/contact/`
    },
    {
        name: t('footer.company.series'),
        url: "https://x.com/BannedSeries",
        blank: true
    }
]

const COMMUNITY = [
    {
        name: t('footer.community.discord'),
        url: "https://discord.gg/sKRYYyVCnw",
        blank: true
    }
]

const LEGAL = [
    {
        name: t('footer.legal.terms'),
        url: `/terms/`
    }
]

import minemu from "../../assets/minemu.webp";
import elysis from "../../assets/elysis.png";
---
<footer class="mt-auto border-t border-linea-2 bg-fondo/70">
    <div class="mx-auto w-full max-w-[1240px] px-5 py-12">
        <div class="flex justify-between gap-10 max-[860px]:flex-col">
            <div>
                <a href="/" class="flex items-center gap-3 group w-max">
                    <span class="mark w-[34px] transition-transform duration-300 group-hover:scale-110"></span>
                    <span class="display text-[1.5rem] tracking-[.05em] text-texto">Banned Studios</span>
                </a>
                <p class="tagline mt-3">{t('hero.title')}</p>

                <div class="mt-8">
                    <Title>{t('footer.affiliates')}</Title>
                    <div class="flex flex-row gap-6">
                        <a href="https://minemu.es/" target="_blank" class="flex flex-row items-center gap-3 group">
                            <Image src={minemu} alt={"Minemu"} format="webp" quality="high" class="w-10 h-10 chamfer-sm" />
                            <div class="flex flex-col leading-tight">
                                <span class="text-texto group-hover:text-oro transition-colors duration-300">Minemu</span>
                                <span class="mono text-[0.75rem] text-texto-3">Hosting</span>
                            </div>
                        </a>
                        <a href="https://elysiscreative.com/" target="_blank" class="flex flex-row items-center gap-3 group">
                            <Image src={elysis} alt={"Elysis Creative"} format="webp" quality="high" class="w-10 h-10 chamfer-sm" />
                            <div class="flex flex-col leading-tight">
                                <span class="text-texto group-hover:text-oro transition-colors duration-300">Elysis</span>
                                <span class="mono text-[0.75rem] text-texto-3">Creative</span>
                            </div>
                        </a>
                    </div>
                </div>
            </div>

            <div class="grid grid-cols-3 gap-12 max-[520px]:grid-cols-2 max-[520px]:gap-8">
                <Column col={COMPANY} title={t('footer.company')}/>
                <Column col={COMMUNITY} title={t('footer.community')}/>
                <Column col={LEGAL} title={t('footer.legal')}/>
            </div>
        </div>

        <div class="rule mt-10 pt-6 flex items-center justify-between gap-4 max-[560px]:flex-col max-[560px]:items-start">
            <span class="mono text-[0.8rem] text-texto-3">© 2026 Banned Studios</span>
            <Networks/>
        </div>
    </div>
</footer>
