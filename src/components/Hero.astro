---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { getCollection } from "astro:content";
import { getLang, useTranslations } from "../i18n/utils";

const lang = getLang(Astro.cookies, Astro.request);
const t = useTranslations(lang);

// Último proyecto = el de mayor "order"
const all = await getCollection('proyectos');
const latest = all
  .filter((item) => item.slug.startsWith(`${lang}/`))
  .map((item) => ({ ...item.data, slug: item.slug.replace(`${lang}/`, "") }))
  .sort((a, b) => (b.order ?? 0) - (a.order ?? 0))[0];

const projectImages = import.meta.glob<{ default: ImageMetadata }>('../assets/projects/*.{png,jpg,jpeg,webp,avif,svg}', { eager: true });
const latestImage = latest && Object.entries(projectImages).find(([path]) => {
  const filename = path.split('/').pop()?.replace(/\.[^.]+$/, '');
  return filename === latest.slug;
})?.[1]?.default;

const isSerie = latest?.type?.toLowerCase().startsWith('seri');
---

<!-- Portada (manual de marca · página web): lockup con el lema a la izquierda y el último proyecto a la derecha -->
<section class="hero relative w-full max-w-[1200px] mx-auto px-5 pt-14 pb-14 grid grid-cols-[1.15fr_1fr] gap-12 items-center max-[1100px]:grid-cols-1 max-[1100px]:gap-14 max-[1100px]:pt-10">
    <div class="hero-in">
        <div class="flex items-center gap-7 max-[560px]:flex-col max-[560px]:items-start max-[560px]:gap-5">
            <div class="frame frame-lg shrink-0 relative">
                <div class="absolute inset-0 -z-10 rounded-full bg-[radial-gradient(circle,rgba(224,184,98,.16)_0%,transparent_70%)] scale-150"></div>
                <img src="/brand/logo3d.webp" alt="Banned Studios" width="150" height="150" class="block w-[150px] h-[150px] -m-3 object-contain max-[560px]:w-[110px] max-[560px]:h-[110px]" loading="eager" />
            </div>
            <div>
                <div class="kicker">Minecraft <span class="mark w-[14px]"></span> Studio</div>
                <h1 class="word text-[clamp(2.6rem,5.4vw,4.4rem)] mt-3">{t('hero.title')}</h1>
            </div>
        </div>
        <p class="mt-6 max-w-[460px] text-[1.02rem] leading-relaxed">
            {t('hero.desc')}
            <a href="/about/" class="text-texto underline decoration-oro underline-offset-4 hover:text-oro transition-colors duration-300">{t('hero.descLink')}</a>
        </p>
        <div class="flex flex-wrap gap-6 items-center mt-8">
            <a class="btn btn-primary btn-lg" href="#proyectos">{t('index.viewProjects')}</a>
            <a class="link-arrow" href="/contact/">{t('index.cta.contact')}</a>
        </div>
    </div>

    {latest && (
        <div class="hero-in hero-in-2 min-w-0 flex gap-8 items-center max-[560px]:flex-col max-[560px]:items-start">
            <a href={`/projects/${latest.slug}/`} class="frame frame-lg group shrink-0" aria-label={latest.title}>
                <Image src={latestImage!} alt={latest.title} format="webp" quality="high" width={520} height={520} loading="eager"
                       class="block w-[240px] h-[240px] object-cover chamfer-lg transition-transform duration-500 group-hover:scale-[1.03] max-[560px]:w-[200px] max-[560px]:h-[200px]" transition:name={latest.slug} />
            </a>
            <div>
                <div class="mono text-[0.75rem] tracking-[.14em] text-oro uppercase">{t('index.latest')}</div>
                <a href={`/projects/${latest.slug}/`} class="display block text-[clamp(1.9rem,3.4vw,2.4rem)] mt-2 break-words hover:text-oro transition-colors duration-300">{latest.title}</a>
                <span class={`tag mt-3 ${isSerie ? 'tag-serie' : ''}`}>{latest.type}</span>
                <p class="mt-3 text-[0.9rem] leading-relaxed max-w-[280px] line-clamp-3">{latest.desc}</p>
                <a href={`/projects/${latest.slug}/`} class="link-arrow mt-5">{t('index.viewProject')}</a>
            </div>
        </div>
    )}
</section>

<style>
    @keyframes heroIn {
        from { opacity: 0; transform: translateY(16px); }
        to { opacity: 1; transform: translateY(0); }
    }
    .hero-in { animation: heroIn .9s cubic-bezier(.2,.7,.2,1) both; }
    .hero-in-2 { animation-delay: .15s; }
    @media (prefers-reduced-motion: reduce) { .hero-in { animation: none; } }
</style>
