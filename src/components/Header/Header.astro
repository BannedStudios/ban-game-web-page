---
import Download from "../Icons/Download.astro";
import NavButtons from "./NavButtons.astro";
import { getLang, useTranslations } from '../../i18n/utils';
import { SignedOut, SignInButton, SignedIn, UserButton } from "@clerk/astro/components";

const lang = getLang(Astro.cookies, Astro.request);
const t = useTranslations(lang);

const targetLang = lang === "es" ? "en" : "es";
const targetLabel = lang === "es" ? "English" : "Español";
const targetLabelShort = lang === "es" ? "EN" : "ES";
---

<div class="mb-[64px]">
    <!-- Barra superior fija sobre el fondo (manual de marca · componentes web) -->
    <header class="bg-fondo/80 backdrop-blur-[10px] fixed w-full h-[64px] z-[1000] border-b border-linea">
        <div class="max-w-[1200px] flex items-center justify-between gap-6 mx-auto px-5 h-full">
            <div class="flex items-center gap-4">
                <button type="button" aria-label="Menú" class="hamburger hidden flex-col gap-[4px] cursor-pointer z-[1001] relative w-[22px] max-[1050px]:flex" id="hamburger">
                    <span class="block w-[22px] h-[2px] bg-texto rounded-[2px] transition-all duration-300 ease-in-out"></span>
                    <span class="block w-[22px] h-[2px] bg-texto rounded-[2px] transition-all duration-150 ease-in-out"></span>
                    <span class="block w-[22px] h-[2px] bg-texto rounded-[2px] transition-all duration-300 ease-in-out"></span>
                </button>

                <a href="/" class="flex items-center gap-2.5 group" aria-label="Banned Studios">
                    <span class="mark w-[28px] transition-transform duration-300 group-hover:scale-110"></span>
                    <span class="display text-[1.15rem] tracking-[.05em] text-texto max-[420px]:hidden">Banned Studios</span>
                </a>
            </div>

            <nav class="max-[1050px]:hidden">
                <ul class="flex flex-row gap-7">
                    <NavButtons/>
                </ul>
            </nav>

            <div class="flex flex-row items-center gap-2">
                <button type="button" data-lang-toggle data-target-lang={targetLang} class="btn btn-ghost btn-sm" title={targetLabel}>
                    <span class="max-[560px]:hidden">{targetLabel}</span><span class="hidden max-[560px]:inline">{targetLabelShort}</span>
                </button>

                <a href="/launcher/" class="btn btn-secondary btn-sm">
                    <Download class="w-4 h-4"/>
                    <span class="max-[720px]:hidden">Ban Game Launcher</span><span class="hidden max-[720px]:inline">Launcher</span>
                </a>

                <div class="flex max-[640px]:hidden">
                    <SignedOut>
                        <SignInButton mode="modal" class="btn btn-ghost btn-sm">
                            {t('nav.login')}
                        </SignInButton>
                    </SignedOut>
                    <SignedIn>
                        <UserButton/>
                    </SignedIn>
                </div>
            </div>
        </div>
    </header>
</div>

<!-- Menú lateral en móvil -->
<div class="menu fixed top-[64px] left-0 w-full max-w-[360px] h-[calc(100%-64px)] bg-fondo/95 backdrop-blur-[10px] border-r border-linea p-6 z-[999]" id="menu">
    <ul class="flex flex-col gap-5 text-[1.05rem]">
        <NavButtons/>

        <li class="hidden max-[640px]:flex pt-3 rule">
            <SignedOut>
                <SignInButton mode="modal" class="btn btn-ghost btn-sm mt-3">
                    {t('nav.login')}
                </SignInButton>
            </SignedOut>
            <SignedIn>
                <UserButton/>
            </SignedIn>
        </li>
    </ul>
</div>

<style>
    .hamburger.open span:nth-child(1) {
        transform: translateY(6px) rotate(45deg);
    }

    .hamburger.open span:nth-child(2) {
        opacity: 0;
        transition: opacity 0.1s ease-in-out;
    }

    .hamburger.open span:nth-child(3) {
        transform: translateY(-6px) rotate(-45deg);
    }

    .hamburger:hover span {
        background-color: var(--color-oro);
    }

    .menu {
        transform: translateX(-100%);
        transition: transform 0.3s ease-in-out;
    }

    .menu.open {
        transform: translateX(0);
    }
</style>

<script>
    init();

    document.addEventListener('astro:after-swap', () => {
        init();
    });

    function init () {
        const hamburger = document.getElementById("hamburger");
        const menu = document.getElementById("menu");

        if (hamburger != null && menu != null) {
            hamburger.addEventListener("click", () => {
                menu.classList.toggle("open");
                hamburger.classList.toggle("open");
            });
            window.addEventListener("resize", () => {
                if (window.innerWidth >= 1050) {
                    menu.classList.remove("open");
                    hamburger.classList.remove("open");
                }
            });
        }

        const toggleButtons = document.querySelectorAll('[data-lang-toggle]');
        toggleButtons.forEach(btn => {
            btn.addEventListener('click', () => {
                const targetLang = btn.getAttribute('data-target-lang') || 'es';
                document.cookie = `user_lang=${targetLang}; path=/; max-age=31536000; SameSite=Lax`;
                window.location.reload();
            });
        });
    }
</script>
