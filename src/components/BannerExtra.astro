---
import { Image } from "astro:assets"
import type { ImageMetadata } from "astro"

const { src } = Astro.props

const bannerImages = import.meta.glob<{ default: ImageMetadata }>('../assets/banners/*.webp', { eager: true });
const image = bannerImages[`../assets/banners/${src}.webp`]?.default;
---

<div class="opacity-0 transition-opacity duration-1000 ease-in-out overflow-hidden relative" style="mask-image: linear-gradient(to bottom, black 40%, transparent);">
    <Image src={image} alt="Banner" loading="eager" class="w-full" onload="this.parentElement.classList.add('animate-fade-up')"/>
    <div class="absolute inset-0 bg-black opacity-65 pointer-events-none"></div>
</div>

<style>
    .animate-fade-up {
        opacity: 1;
    }

    @keyframes fadeUp {
        0% {
            opacity: 0;
            transform: translateY(20px);
        }
        100% {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .animate-fade-up {
        animation: fadeUp 1s ease-out forwards;
    }
</style>