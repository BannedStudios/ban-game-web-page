---
import Layout from "../layouts/Layout.astro"
import Title from "../components/Title.astro"
import { Image } from "astro:assets"
import launcher from '../assets/launcher.webp'
import MainPage from "../components/MainPage.astro"
import Desc from "../components/Desc.astro"
import Windows from "../components/Icons/Windows.astro"
import { getLang, useTranslations } from '../i18n/utils';

const lang = getLang(Astro.cookies, Astro.request);
const t = useTranslations(lang);
---

<Layout title="Launcher" image="/pages/launcher.webp" desc={t("launcher.desc")}>
    <MainPage class="mt-15">
        <div class="kicker">Launcher</div>
        <Title class="mt-3">Ban Game Launcher</Title>
        <Desc class="mt-3 max-w-[640px]">{t("launcher.desc2")}</Desc>

        <div class="notice mt-7 max-w-[640px] mx-5">
            <div class="notice-title">{t("launcher.warningTitle")}</div>
            <p class="text-[0.9rem] leading-relaxed mt-1.5">{t("launcher.warning")}<a href="https://discord.gg/sKRYYyVCnw" target="_blank" class="text-texto underline decoration-oro underline-offset-4 hover:text-oro transition-colors duration-300">Discord</a>.</p>
        </div>

        <div class="flex flex-wrap flex-col items-center justify-center mt-8">
            <a href="https://cdn.stackedhost.crysistudio.xyz/ban-game-launcher/release/latest/ban-game-launcher-setup.exe" class="btn btn-primary btn-lg">
                <Windows />
                <span>{t("launcher.downloadWindows")}</span>
            </a>
        </div>

        <div class="frame frame-lg mt-12 w-[90%] max-w-[920px]">
            <Image src={launcher} alt="Launcher" format="webp" loading="eager" quality="high" class="w-full object-cover chamfer-lg"/>
        </div>
    </MainPage>
</Layout>
