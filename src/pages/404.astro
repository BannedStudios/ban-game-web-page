---
import Desc from "../components/Desc.astro";
import MainPage from "../components/MainPage.astro";
import MiniTitle from "../components/MiniTitle.astro";
import Title from "../components/Title.astro";
import Layout from "../layouts/Layout.astro";
import { getLang, useTranslations } from "../i18n/utils";

const lang = getLang(Astro.cookies, Astro.request);
const t = useTranslations(lang);
---

<Layout title={t("404.title")} desc={t("404.desc")}>
    <MainPage class="min-h-[calc(100vh-125px)]">
        <span class="mark w-[64px] opacity-80"></span>
        <h1 class="word text-[clamp(5rem,14vw,9rem)] mt-4">{t("404.title")}</h1>
        <MiniTitle class="mb-3">{t("404.miniTitle")}</MiniTitle>
        <Desc>{t("404.desc")} <a class="text-texto underline decoration-oro underline-offset-4 hover:text-oro transition-colors duration-300" href="/">{t("404.descLink")}</a>.</Desc>
    </MainPage>
</Layout>

