---
import { networks } from '../../data/networks'
---

<div class="flex gap-5">
    {
        networks.map(network => (
            <a href={network.href} target="_blank" class="text-texto-3 hover:text-oro transition-colors duration-300 ease">
                <network.icon class="w-[18px] h-[18px]"/>
                <span class="sr-only">{network.alt}</span>
            </a>
        ))
    }
</div>
