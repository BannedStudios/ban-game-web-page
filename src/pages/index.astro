---
import Layout from '../layouts/Layout.astro';
import MainPage from '../components/MainPage.astro';
import MiniTitle from '../components/MiniTitle.astro';
import Desc from '../components/Desc.astro';
import Next from '../components/Icons/Next.astro';
import Prev from '../components/Icons/Prev.astro';
import YTVideo from '../components/YTVideo.astro';
import Hero from '../components/Hero.astro';
import Down from '../components/Icons/Down.astro';
import Code from '../components/Icons/Code.astro';
import Cube from '../components/Icons/Cube.astro';
import Gamepad from '../components/Icons/Gamepad.astro';
import BriefCase from '../components/Icons/BriefCase.astro';
import Mail from '../components/Icons/Mail.astro';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { getLang, useTranslations } from '../i18n/utils';

const lang = getLang(Astro.cookies, Astro.request);
const t = useTranslations(lang);

const { videos, proyectos } = await import(`../data/${lang}/index.ts`);

const projectImages = import.meta.glob<{ default: ImageMetadata }>('../assets/projects/*.{png,jpg,jpeg,webp,avif,svg}', { eager: true });

const projectPictures = proyectos.map((proyecto: { slug: string; }) => {
    const avatar = Object.entries(projectImages).find(([path]) => {
        const filename = path.split('/').pop()?.replace(/\.[^.]+$/, '');
        return filename === proyecto.slug;
    })?.[1]?.default;
    return { ...proyecto, avatar };
});
---

<Layout title="Banned Studios" image="/pages/index.webp" desc={`${t('index.desc')}`}>
    <Hero class="h-[calc(100vh-130px)]"/>
    <MainPage class="text-center">
        <button id="down" class="bg-[#333] hover:bg-[#222222] transition-colors duration-300 ease text-white p-2 rounded-full cursor-pointer">
            <Down class="w-6 h-6" />
        </button>

        <section id="proyectos" class="flex flex-col justify-center items-center mt-10">
            <MiniTitle>{t('index.projectsTitle')}</MiniTitle>
    
            <div class="flex flex-wrap gap-[1.4rem] justify-center max-w-[1500px] px-5 mt-5">
                {
                    projectPictures.map(proyecto => {
                        const  { slug, title, type, date, avatar } = proyecto
    
                        return (
                            <article class="flex flex-col gap-3 justify-center text-left bg-[#111] text-white w-[300px] border-[1.5px] border-[rgba(42,42,42,0.500)] overflow-hidden relative z-[0] group">
                                <a href={`/projects/${slug}/`}>
                                    <Image src={avatar} alt={title} format="webp" quality="high" class="w-full h-full" />
                                </a>
                                <Image src={avatar} alt={title} format="webp" quality="high" class="absolute w-full h-full object-cover opacity-[0.10] blur-[2rem] z-[-2] transition-opacity duration-1000 group-hover:opacity-[0.20]" />
                                <div class=" relative z-[-1] px-3 pb-3">
                                <div class="text-[1.2rem] font-medium">{title}</div>
                                <p class="text-[0.9rem] text-[#7b7b7b] font-medium">{type} - {date}</p>
                                </div>
                            </article>
                        )
                    })
                }
            </div>
            <div class="flex flex-wrap flex-col items-center justify-center mt-5">
                <a href="/projects/" class="flex items-center px-4.5 p-1 bg-[#333] rounded-[20px] text-white transition-all duration-300 text-[1.1rem] ease hover:bg-[#222222]">
                    <span>{t('index.projectsMore')}</span>
                </a>
            </div>
        </section>

        <section class="flex flex-col justify-center items-center mt-10">
            <MiniTitle>{t('index.videosTitle')}</MiniTitle>

            <div class="w-[calc(100vw-20px)] pr-2.5 pl-2.5 max-w-[800px] mt-5 mb-5 overflow-hidden">
                <div id="carousel" class="flex items-center space-x-4 overflow-x-auto scroll-smooth snap-x snap-mandatory">
                    {
                        videos.map((video: { src: any; title: any; }) => (
                            <div class="w-[370px] snap-start shrink-0 overflow-hidden">
                                <YTVideo url={video.src} title={video.title}/>
                            </div>
                        ))
                    }
                </div>
            </div>

            <div class="flex flex-row gap-2">
                <button id="prev" class="bg-[#333] hover:bg-[#222222] transition-colors duration-300 ease text-white p-2 rounded-full"><Prev class="w-6 h-6"/></button>
                <button id="next" class="bg-[#333] hover:bg-[#222222] transition-colors duration-300 ease text-white p-2 rounded-full"><Next class="w-6 h-6"/></button>
            </div>
        </section>

        <section class="flex flex-col justify-center items-center mt-12 max-w-[1200px] px-5">
            <MiniTitle class="mb-5">{t('index.servicesTitle')}</MiniTitle>

            <div class="flex flex-wrap gap-[1.4rem] justify-center max-w-[1200px] mt-2">
                <article class="flex flex-col items-center text-center bg-[#111] text-white p-6 rounded-[10px] w-[320px] border-[1.5px] border-[rgba(42,42,42,0.500)] overflow-hidden relative group">
                    <div class="p-3.5 bg-[#222] border-[1.5px] border-[rgba(42,42,42,0.7)] rounded-[10px] text-white mb-3 transition-transform duration-300 ease-in-out group-hover:scale-[1.1]">
                        <Code class="w-8 h-8" />
                    </div>
                    <div class="text-[1.2rem] font-medium text-white mb-2">{t('index.services.mods.title')}</div>
                    <p class="text-[0.9rem] text-[#7b7b7b] leading-relaxed">{t('index.services.mods.desc')}</p>
                </article>

                <article class="flex flex-col items-center text-center bg-[#111] text-white p-6 rounded-[10px] w-[320px] border-[1.5px] border-[rgba(42,42,42,0.500)] overflow-hidden relative group">
                    <div class="p-3.5 bg-[#222] border-[1.5px] border-[rgba(42,42,42,0.7)] rounded-[10px] text-white mb-3 transition-transform duration-300 ease-in-out group-hover:scale-[1.1]">
                        <Cube class="w-8 h-8" />
                    </div>
                    <div class="text-[1.2rem] font-medium text-white mb-2">{t('index.services.builds.title')}</div>
                    <p class="text-[0.9rem] text-[#7b7b7b] leading-relaxed">{t('index.services.builds.desc')}</p>
                </article>

                <article class="flex flex-col items-center text-center bg-[#111] text-white p-6 rounded-[10px] w-[320px] border-[1.5px] border-[rgba(42,42,42,0.500)] overflow-hidden relative group">
                    <div class="p-3.5 bg-[#222] border-[1.5px] border-[rgba(42,42,42,0.7)] rounded-[10px] text-white mb-3 transition-transform duration-300 ease-in-out group-hover:scale-[1.1]">
                        <Gamepad class="w-8 h-8" />
                    </div>
                    <div class="text-[1.2rem] font-medium text-white mb-2">{t('index.services.events.title')}</div>
                    <p class="text-[0.9rem] text-[#7b7b7b] leading-relaxed">{t('index.services.events.desc')}</p>
                </article>
            </div>
        </section>

        <section class="flex flex-col justify-center items-center mt-12 mb-8 max-w-[850px] w-[calc(100vw-40px)] mx-5 bg-[#111] text-white rounded-[10px] p-8 border-[1.5px] border-[#ffffff3e]">
            <MiniTitle class="text-[1.8rem]">{t('index.cta.title')}</MiniTitle>
            <Desc class="mt-2.5 max-w-[650px]">{t('index.cta.desc')}</Desc>
            
            <div class="flex flex-wrap gap-4 mt-6 justify-center items-center">
                <a class="flex flex-row items-center gap-2 px-5 py-3 bg-[#333] rounded-[20px] text-white transition-all duration-300 ease hover:bg-[#222222] text-[1.1rem]" href="/contact/">
                    <Mail class="w-6 h-6" />
                    <span>{t('index.cta.contact')}</span>
                </a>
                <a class="flex flex-row items-center gap-2 px-5 py-3 bg-[#333] rounded-[20px] text-white transition-all duration-300 ease hover:bg-[#222222] text-[1.1rem]" href="/apply/">
                    <BriefCase class="w-6 h-6" />
                    <span>{t('index.cta.apply')}</span>
                </a>
            </div>
        </section>
    </MainPage>
</Layout>

<style>
    #carousel::-webkit-scrollbar {
        display: none;
    }
    #carousel {
        -ms-overflow-style: none;
        scrollbar-width: none;
    }

    .animate-fade-up {
        opacity: 1;
    }

    @keyframes fadeUp {
        0% {
            opacity: 0;
            transform: translateY(20px);
        }
        100% {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .animate-fade-up {
        animation: fadeUp 1s ease-out forwards;
    }
</style>

<script>
    init();

    document.addEventListener('astro:after-swap', init);

    function init () {
        const carousel = document.getElementById('carousel');
        const prev = document.getElementById('prev');
        const next = document.getElementById('next');
        const down = document.getElementById('down');
        const section = document.getElementById('proyectos');

        if (next == null || prev == null || carousel == null || down == null || section == null) return;
        
        next.addEventListener('click', () => {
            carousel.scrollBy({ left: 300, behavior: 'smooth' });
        });
        
        prev.addEventListener('click', () => {
            carousel.scrollBy({ left: -300, behavior: 'smooth' });
        });

        down.addEventListener('click', () => {
            const yOffset = -60;
            const y = section.getBoundingClientRect().top + window.pageYOffset + yOffset;

            window.scrollTo({
                top: y,
                behavior: 'smooth'
            });
        });
    }
</script>