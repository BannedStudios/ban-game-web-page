---
import Layout from "../layouts/Layout.astro";
import MainPage from "../components/MainPage.astro";
import SectionHead from "../components/SectionHead.astro";
import BrandForm from "../components/BrandForm.astro";
import { getLang, useTranslations } from "../i18n/utils";

const lang = getLang(Astro.cookies, Astro.request);
const t = useTranslations(lang);
---

<!-- Formulario propio (antes forms.app): las respuestas se guardan en Firebase y se ven en /registro/formularios/ -->
<Layout title={t("apply.title")} image="/pages/staff.webp" desc={t("apply.desc")}>
    <MainPage class="mt-16 px-5">
        <SectionHead kicker={t("apply.title")} title={t("apply.heading")} size="md" as="h1" align="center" class="mb-10 max-w-[860px]" />
        <BrandForm form="apply" />
    </MainPage>
</Layout>
