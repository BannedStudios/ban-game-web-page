---
const currentPath = Astro.url.pathname;

import { getLang, useTranslations } from '../../i18n/utils';

const lang = getLang(Astro.cookies, Astro.request);
const t = useTranslations(lang);

const sections = [
    {
        label: t('nav.home'),
        href: `/`,
    },
    {
        label: t('nav.projects'),
        href: `/projects/`,
        desc: t('nav.projectsDesc')
    },
    {
        label: t('nav.staff'),
        href: `/staff/`,
        desc: t('nav.staffDesc')
    },
    {
        label: t('nav.apply'),
        href: `/apply/`,
        desc: t('nav.applyDesc')
    },
    {
        label: t('nav.contact'),
        href: `/contact/`,
    }
];
---

{
    sections.map(section => (
        <li>
            <a href={section.href} title={section.desc} class={` transition-colors duration-300 ease hover:text-[#ccc] ${currentPath === section.href ? "text-[#9a9999] font-medium" : ""}`}>
                {section.label}
            </a>
        </li>
    ))
}